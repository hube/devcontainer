{
  "id": "ccstatusline",
  "name": "ccstatusline",
  "version": "1.0.0",
  "dependsOn": {
    "ghcr.io/devcontainers/features/node:2": {
      "npmVersion": "latest"
    },
  },
  "mounts": [
    {
      "type": "bind",
      "source": "${localEnv:HOME}/.config/ccstatusline",
      "target": "/home/${localEnv:USERNAME:devcontainer}/.config/ccstatusline"
    }
  ]
}
