{
  "id": "ssh",
  "name": "SSH",
  "version": "1.0.0",
  "installsAfter": ["ghcr.io/devcontainers/features/common-utils"],
  "mounts": [
    // Mount socket to share SSH identities between host and dev container
    // This host mount point is specific to Docker Desktop on MacOS
    {
      "type": "bind",
      "source": "/run/host-services/ssh-auth.sock",
      "target": "/run/host-services/ssh-auth.sock"
    },
    {
      "type": "bind,readonly",
      "source": "${localEnv:HOME}/.ssh/known_hosts",
      "target": "/home/${localEnv:USERNAME:devcontainer}/host-readonly/home/.ssh/known_hosts"
    }
  ],
  "containerEnv": {
    "SSH_AUTH_SOCK": "/run/host-services/ssh-auth.sock"
  },
  "postStartCommand": "~/bin/devcontainer-feature/ssh/postStartScript.sh"
}
